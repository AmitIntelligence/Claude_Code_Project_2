# ---------------------------------------------------------------------------
# Connection / credential template for the OIC Invoice Quality Agent.
# Copy to `.env` (which is gitignored) and fill in real values, OR inject
# these via your secret store / orchestrator. NEVER commit real secrets.
# All credentials are used for READ-ONLY access (instructions.md §5.1, §5.5).
# ---------------------------------------------------------------------------

# --- Oracle Integration Cloud (OIC) ---
OIC_BASE_URL=https://your-oic-instance.integration.ocp.oraclecloud.com
# OIC supports OAuth client credentials or basic auth. Prefer OAuth.
OIC_AUTH_TYPE=oauth                       # oauth | basic
OIC_OAUTH_TOKEN_URL=https://idcs-xxxx.identity.oraclecloud.com/oauth2/v1/token
OIC_CLIENT_ID=
OIC_CLIENT_SECRET=
OIC_SCOPE=urn:opc:resource:consumer::all
# Fallback basic auth (only if OIC_AUTH_TYPE=basic):
OIC_USERNAME=
OIC_PASSWORD=

# --- File staging drop zone (SFTP mount / blob path OIC writes before Cleo) ---
# Point this at a locally-mounted, read-only path to the drop zone.
STAGING_DIR=/mnt/oic-cleo-dropzone

# --- Cleo (Cleo Integration Cloud / VLTrader / Harmony) ---
CLEO_BASE_URL=https://your-cleo-instance.cleo.com
CLEO_API_TOKEN=
# Or basic auth if your Cleo deployment uses it:
CLEO_USERNAME=
CLEO_PASSWORD=

# --- Power BI SQL sink (Azure SQL / SQL Server) ---
# Used by Power BI via DirectQuery or scheduled refresh.
# Example (pyodbc): Driver={ODBC Driver 18 for SQL Server};Server=tcp:srv.database.windows.net,1433;Database=bi;Uid=agent;Pwd=...;Encrypt=yes
BI_SQL_CONN_STR=

# --- Optional alert webhook (Teams/Slack/etc.) — informational only ---
ALERT_WEBHOOK_URL=
